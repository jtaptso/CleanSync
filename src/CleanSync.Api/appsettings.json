{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "CleanSync": "Debug"
    },
    "Console": {
      "FormatterName": "Json",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff zzz"
      }
    },
    "EventSource": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "${DB_CONNECTION_STRING}"
  },
  "UseInMemoryDb": false,
  "DemoMode": false,
  "SapConnection": {
    "ServiceLayerUrl": "${SAP_SERVICE_LAYER_URL}",
    "CompanyDb": "${SAP_COMPANY_DB}",
    "UserName": "${SAP_USERNAME}",
    "Password": "${SAP_PASSWORD}",
    "SessionTimeoutMinutes": 30
  },
  "HealthChecks": {
    "Enabled": true,
    "DetailedErrors": true,
    "ReadinessChecks": ["Database", "SapConnection", "EcommerceConnection"]
  }
}
